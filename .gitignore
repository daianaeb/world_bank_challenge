# Python virtual environment and cache
.venv/
__pycache__/

# Generated output folders
logs/*
raw_data/*
!raw_data/.gitkeep
analytics_outputs/*
!analytics_outputs/.gitkeep

# Ignore CSV files except CSV files in sample_data
*.csv
!sample_data/
!sample_data/*.csv
!sample_data/**/*.csv

# Ignore PNG files except PNG files in sample_data
*.png
!sample_data/
!sample_data/*.png
!sample_data/**/*.png
